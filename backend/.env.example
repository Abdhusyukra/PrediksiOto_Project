# Salin isi file ini ke Railway Environment Variables
# Jangan commit file .env asli ke GitHub!

# Tambahkan DATABASE_URL dari Neon (Database -> Connection String)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
JWT_SECRET_KEY=  # Ganti dengan string acak panjang (min 32 karakter)
FLASK_ENV=production
